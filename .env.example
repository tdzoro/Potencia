# POTENCIA — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never be
# committed. The backend reads every value below through pydantic-settings, so
# the `POTENCIA_` prefix is part of the variable name.
#
# The frontend has its own template at `frontend/.env.example`.

# --- Runtime ------------------------------------------------------------------
# development | production. Production refuses to start while SECRET_KEY still
# holds the insecure development placeholder.
POTENCIA_ENVIRONMENT=development
POTENCIA_APP_VERSION=0.1.0
POTENCIA_LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------
# Host-run development points at localhost; inside Docker Compose the host is the
# service name `db`.
POTENCIA_DATABASE_URL=postgresql+psycopg://potencia:potencia@localhost:5432/potencia

# --- Security -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
POTENCIA_SECRET_KEY=replace-with-a-64-character-random-string

# Comma-separated allow-list. Never use a wildcard: credentialed CORS with `*`
# is both invalid and unsafe.
POTENCIA_CORS_ORIGINS=http://localhost:5173
