# POTENCIA — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never be
# committed. The backend reads every value below through pydantic-settings, so
# the `POTENCIA_` prefix is part of the variable name.
#
# The frontend has its own template at `frontend/.env.example`.

# --- Runtime ------------------------------------------------------------------
# development | production. Production refuses to start while SECRET_KEY still
# holds the insecure development placeholder.
POTENCIA_ENVIRONMENT=development
POTENCIA_APP_VERSION=0.1.0
POTENCIA_LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------
# Host-run development points at localhost; inside Docker Compose the host is the
# service name `db`.
POTENCIA_DATABASE_URL=postgresql+psycopg://potencia:potencia@localhost:5432/potencia

# --- Security -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
POTENCIA_SECRET_KEY=replace-with-a-64-character-random-string

# Comma-separated allow-list. Never use a wildcard: credentialed CORS with `*`
# is both invalid and unsafe.
POTENCIA_CORS_ORIGINS=http://localhost:5173

# --- Rate limits --------------------------------------------------------------
# Share rate-limit counters across API workers. Docker Compose points this at the
# bundled Redis; leave it empty for a single process, where the limiter keeps its
# own counters and logs that it is doing so.
POTENCIA_REDIS_URL=

# On by default and must stay on in production. Only a benchmark or load test
# switches it off, because otherwise the run measures the throttle.
POTENCIA_RATE_LIMIT_ENABLED=true

# --- Malware Scanning (ClamAV) ------------------------------------------------
# Anti-malware scanning for uploaded documents via ClamAV daemon.
# When enabled, uploads are scanned via the ClamAV INSTREAM protocol prior to storage.
# In development/test mode, scanner falls back to test engine if clamav daemon is unreachable.
# In production or when POTENCIA_CLAMAV_REQUIRED=true, scans fail closed (503 Service Unavailable).
POTENCIA_CLAMAV_ENABLED=true
POTENCIA_CLAMAV_HOST=localhost
POTENCIA_CLAMAV_PORT=3310
POTENCIA_CLAMAV_TIMEOUT_SECONDS=10
POTENCIA_CLAMAV_REQUIRED=false

# --- Document Processing Limits -----------------------------------------------
POTENCIA_MAX_UPLOAD_BYTES=5242880
POTENCIA_MAX_PDF_PAGES=50
POTENCIA_MAX_DOCX_ENTRIES=1000

# --- AI Provider (Google Gemini) ----------------------------------------------
# Optional AI writing assistant for resume suggestions. When unset, POTENCIA
# uses NullRewriteProvider and falls back to deterministic rule-based advice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternative prefixed form:
POTENCIA_GEMINI_API_KEY=
POTENCIA_GEMINI_MODEL=gemini-2.5-flash
