# ResumeIQ Application Configuration

# Application
PROJECT_NAME="ResumeIQ – AI Resume Analyzer"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Security & Authentication
# Generated secure key: openssl rand -hex 32
SECRET_KEY="change-this-in-production-to-a-very-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For PostgreSQL (Docker or local):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resumeiq"
# For local development with zero external dependencies (fallback):
DATABASE_URL="sqlite:///./resumeiq.db"

# AI Provider Configuration (Google Gemini)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3

# File Upload Rules
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf", "docx"]
UPLOAD_DIR="./uploads"

# CORS Configuration (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
