# POTENCIA frontend — environment template
#
# Copy to `.env.local`. Vite only exposes variables prefixed with `VITE_`, and
# their values are baked into the bundle at build time — never put a secret here.

# Base URL of the POTENCIA API. Omit it to fall back to http://localhost:8000.
# In development the Vite proxy forwards /api and /health to the backend, so
# leaving this unset also works.
VITE_API_BASE_URL=http://localhost:8000
